{
  "name": "longo-e2e-tests",
  "version": "1.0.0",
  "description": "Cypress E2E test suite for Longo.lv",
  "main": "index.js",
  "scripts": {
    "clean:reports": "node -e \"fs.rmSync('cypress/reports', { recursive: true, force: true })\"",
    "pretest": "npm run clean:reports",
    "test": "cypress run",
    "test:chrome": "cypress run --browser chrome",
    "test:parallel": "cypress run --record --parallel",
    "test:firefox": "cypress run --browser firefox",
    "test:custom": "cypress run --config baseUrl=$CY_URL --env locale=$CY_LOCALE --browser $CY_BROWSER",
    "report:merge": "node -e \"fs.mkdirSync('cypress/reports', { recursive: true })\" && mochawesome-merge cypress/reports/mocha/*.json > cypress/reports/report.json",
    "report:generate": "marge cypress/reports/report.json -f report -o cypress/reports/html",
    "posttest": "npm run report:merge && npm run report:generate"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "cypress": "^13.17.0",
    "cypress-axe": "^1.7.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}
